{
  "name": "Additional programming languages",
  "scopeName": "source.shell",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash" },
        { "match": "#.*$", "name": "comment.line.number-sign" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block" }
      ]
    },
    "strings": {
      "patterns": [
        { "begin": "\"", "end": "\"", "name": "string.quoted.double", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape" }] },
        { "begin": "'", "end": "'", "name": "string.quoted.single", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape" }] },
        { "begin": "`", "end": "`", "name": "string.quoted.other", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape" }] }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9]+(?:\\.[0-9]+)?)\\b", "name": "constant.numeric" }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(?:if|else|elif|for|foreach|while|do|then|fi|case|switch|match|break|continue|return|function|def|class|struct|enum|interface|import|export|from|package|use|module|namespace|public|private|protected|static|const|let|var|fn|func|async|await|select|where|join|insert|update|delete|create|drop|true|false|null|nil|none)\\b", "name": "keyword.control" }
      ]
    }
  }
}
