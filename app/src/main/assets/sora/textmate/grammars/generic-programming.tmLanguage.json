{
  "name": "Generic programming and configuration",
  "scopeName": "source.generic",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash" },
        { "match": "#.*$", "name": "comment.line.number-sign" },
        { "match": ";;.*$", "name": "comment.line.semicolon" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block" }
      ]
    },
    "strings": {
      "patterns": [
        { "begin": "\"", "end": "\"", "name": "string.quoted.double", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape" }] },
        { "begin": "'", "end": "'", "name": "string.quoted.single", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape" }] },
        { "begin": "`", "end": "`", "name": "string.quoted.other", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape" }] }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\\b", "name": "constant.numeric" }
      ]
    },
    "annotations": {
      "patterns": [
        { "match": "@[A-Za-z_][A-Za-z0-9_.-]*", "name": "storage.type.annotation" }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(?:if|else|elif|for|foreach|while|do|then|fi|case|switch|match|break|continue|return|yield|throw|try|catch|finally|function|def|class|struct|enum|interface|trait|import|export|from|package|use|module|namespace|public|private|protected|internal|static|final|const|let|var|val|fn|func|async|await|select|where|join|insert|update|delete|create|drop|as|in|is|of|new|extends|implements|override|operator|with|begin|end|require|include)\\b", "name": "keyword.control" }
      ]
    },
    "types": {
      "patterns": [
        { "match": "\\b(?:bool|boolean|byte|char|double|float|int|integer|long|number|string|object|void|unit|any|auto|self|Self|this|fn|map|list|array|Date|Result|Option)\\b", "name": "storage.type" }
      ]
    },
    "constants": {
      "patterns": [
        { "match": "\\b(?:true|false|null|nil|none|undefined|NaN|Infinity)\\b", "name": "constant.language" }
      ]
    }
  }
}
