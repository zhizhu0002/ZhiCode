# Gradle / AGP
.gradle/
build/
*/build/
local.properties
.cxx/

# IDE
.idea/
*.iml

# 本地临时产物
*.keystore
*.jks

# 工具的编译产物（源码 VerifyBootstrap.java 在版本库里）
tools/termux-bootstrap-fork/*.class

# Kotlin 会话目录（IDE / 编译器插件生成）
.kotlin/

# Release 签名配置与密钥库：绝不进版本库
# （密钥库本体在仓库之外 ~/.android-keys/，这里再兜一道）
release.properties
*.jks

# test-source-no-build.sh 的编译缓存（它把 app/tests/*.java 编译一次成 jar 再跑）。
# 是产物、可随时重建，不进版本库。
.test-build/

# 快路径单测的编译缓存（test-jvm-fast.sh）
.test-jvm/

# 临时产物：APK 抽查解包、构建日志
.apkchk/
.build-*.log
